# ABC WebApp — Local Configuration Template
# Copy this file, fill in your values, and set via IIS Application Settings
# or your local Web.config connectionStrings section.
# NEVER commit actual credentials to git.

# SQL Server connection string (set this in IIS App Pool > Advanced Settings > Environment Variables
# or directly in Web.config connectionStrings for local dev only — do NOT commit if it has credentials)
DB_CONNECTION_STRING=Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;Integrated Security=True

# Example for SQL Auth (not recommended — prefer Windows Auth):
# DB_CONNECTION_STRING=Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;
