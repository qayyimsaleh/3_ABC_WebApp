<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <title>@ViewBag.Title &mdash; ABC Portal</title>
    <script>(function () { var m = document.cookie.match(/(?:^|; )abc_theme=([^;]*)/); if (m && decodeURIComponent(m[1]) === 'light') document.documentElement.setAttribute('data-theme', 'light'); })();</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>

        :root {
            --bg:      #080b12;
            --s1:      #0e1420;
            --s2:      #151d2e;
            --s3:      #1e2a40;
            --s4:      #283650;
            --bd:      rgba(255,255,255,.07);
            --bd2:     rgba(255,255,255,.13);
            --blue:    #5b9cf6;
            --blue-d:  #4285f4;
            --blue-g:  rgba(91,156,246,.14);
            --blue-g2: rgba(91,156,246,.07);
            --teal:    #34d4c0;
            --purple:  #b197fc;
            --green:   #40d99e;
            --green-g: rgba(64,217,158,.12);
            --red:     #f87171;
            --red-g:   rgba(248,113,113,.12);
            --amber:   #fbbf24;
            --amber-g: rgba(251,191,36,.12);
            --t1:  #eef2ff;
            --t2:  #8e9ebc;
            --t3:  #475569;
            --r:   8px;
            --rl:  12px;
            --rxl: 16px;
            --tr:  all .15s ease;
        }

        /* ─ LIGHT THEME ─ */
        [data-theme="light"] {
            --bg:      #f1f5fb;
            --s1:      #ffffff;
            --s2:      #e8edf7;
            --s3:      #d6dff0;
            --s4:      #c0ccde;
            --bd:      rgba(0,0,0,.09);
            --bd2:     rgba(0,0,0,.16);
            --blue:    #2563eb;
            --blue-d:  #1d4ed8;
            --blue-g:  rgba(37,99,235,.10);
            --blue-g2: rgba(37,99,235,.05);
            --teal:    #0d9488;
            --purple:  #7c3aed;
            --green:   #16a34a;
            --green-g: rgba(22,163,74,.09);
            --red:     #dc2626;
            --red-g:   rgba(220,38,38,.09);
            --amber:   #d97706;
            --amber-g: rgba(217,119,6,.09);
            --t1: #0f172a;
            --t2: #374151;
            --t3: #6b7280;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box }

        html { scroll-behavior: smooth }

        body {
            font-family: 'Inter','Plus Jakarta Sans',sans-serif;
            font-size: 15px;
            background: var(--bg);
            color: var(--t1);
            line-height: 1.65;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Plus Jakarta Sans','Inter',sans-serif
        }

        ::-webkit-scrollbar { width: 5px; height: 5px }
        ::-webkit-scrollbar-track { background: transparent }
        ::-webkit-scrollbar-thumb { background: var(--s4); border-radius: 3px }

        .wrap    { max-width: 1200px; margin: 0 auto; padding: 0 28px }
        .wrap-xl { max-width: 1500px; margin: 0 auto; padding: 0 28px }

        main { flex: 1; padding: 44px 0 88px }

        /* NAV */
        nav {
            background: rgba(8,11,18,.88);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border-bottom: 1px solid var(--bd);
            position: sticky;
            top: 0;
            z-index: 300
        }

        [data-theme="light"] nav { background: rgba(255,255,255,.92) }

        /* ─ THEME TOGGLE ─ */
        .theme-toggle {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--bd);
            background: var(--s2);
            color: var(--t2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            transition: var(--tr);
            margin-right: 0;
            flex-shrink: 0
        }

            .theme-toggle:hover {
                border-color: rgba(251,191,36,.4);
                color: var(--amber);
                background: var(--amber-g)
            }

        .nav-inner {
            max-width: 1500px;
            margin: 0 auto;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg,var(--blue),var(--purple));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #fff;
            box-shadow: 0 0 24px rgba(91,156,246,.4),0 0 48px rgba(91,156,246,.1);
            flex-shrink: 0
        }

        .brand-text { line-height: 1.25 }

        .brand-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--t1);
            letter-spacing: -.1px
        }

        .brand-sub {
            font-size: 11px;
            color: var(--t3);
            text-transform: uppercase;
            letter-spacing: .6px
        }

        .nav-center {
            display: flex;
            align-items: center;
            gap: 2px
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border-radius: var(--r);
            font-size: 14px;
            font-weight: 500;
            color: var(--t3);
            text-decoration: none;
            transition: var(--tr)
        }

            .nav-link:hover, .nav-link.active {
                color: var(--t1);
                background: var(--s2)
            }

            .nav-link.active {
                color: var(--blue);
                background: var(--blue-g)
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 9px;
            background: var(--s2);
            border: 1px solid var(--bd);
            border-radius: 40px;
            padding: 4px 14px 4px 4px
        }

        .user-av {
            width: 28px;
            height: 28px;
            background: linear-gradient(135deg,var(--blue),var(--purple));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0
        }

        .user-info { line-height: 1.25 }

        .user-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--t1);
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        .user-id {
            font-size: 11px;
            color: var(--t3);
            font-family: 'JetBrains Mono',monospace
        }

        .btn-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: var(--r);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: var(--tr);
            border: 1px solid var(--bd);
            background: transparent;
            color: var(--t2)
        }

            .btn-nav:hover {
                border-color: rgba(248,113,113,.35);
                color: var(--red);
                background: var(--red-g)
            }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            border: none;
            border-radius: var(--r);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--tr);
            text-decoration: none;
            white-space: nowrap;
            font-family: inherit;
            letter-spacing: -.1px
        }

        .btn-primary {
            background: var(--blue);
            color: #fff;
            box-shadow: 0 1px 2px rgba(0,0,0,.25)
        }

            .btn-primary:hover {
                background: var(--blue-d);
                box-shadow: 0 0 0 3px var(--blue-g),0 4px 16px rgba(91,156,246,.3)
            }

        .btn-ghost {
            background: var(--s2);
            color: var(--t2);
            border: 1px solid var(--bd)
        }

            .btn-ghost:hover {
                border-color: var(--bd2);
                color: var(--t1);
                background: var(--s3)
            }

        .btn-danger {
            background: var(--red-g);
            color: var(--red);
            border: 1px solid rgba(248,113,113,.22)
        }

            .btn-danger:hover { background: rgba(248,113,113,.22) }

        .btn-success {
            background: var(--green-g);
            color: var(--green);
            border: 1px solid rgba(64,217,158,.22)
        }

            .btn-success:hover { background: rgba(64,217,158,.22) }

        .btn-sm { padding: 7px 14px; font-size: 13px }

        .btn-full { width: 100% }

        .btn:disabled {
            opacity: .4;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important
        }

        /* CARDS */
        .card {
            background: var(--s1);
            border: 1px solid var(--bd);
            border-radius: var(--rxl);
            padding: 24px;
            box-shadow: 0 1px 3px rgba(0,0,0,.35)
        }

        [data-theme="light"] .card {
            box-shadow: 0 1px 3px rgba(0,0,0,.07),0 4px 16px rgba(0,0,0,.05)
        }

        /* BADGES */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .3px
        }

        .badge-pass {
            background: var(--green-g);
            color: var(--green);
            border: 1px solid rgba(64,217,158,.2)
        }

        .badge-fail {
            background: var(--red-g);
            color: var(--red);
            border: 1px solid rgba(248,113,113,.2)
        }

        .badge-blue {
            background: var(--blue-g);
            color: var(--blue);
            border: 1px solid rgba(91,156,246,.2)
        }

        .badge-amber {
            background: var(--amber-g);
            color: var(--amber);
            border: 1px solid rgba(251,191,36,.2)
        }

        .badge-purple {
            background: rgba(177,151,252,.1);
            color: var(--purple);
            border: 1px solid rgba(177,151,252,.2)
        }

        /* FORM */
        .form-group { margin-bottom: 18px }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--t2);
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: .3px
        }

        .form-input {
            width: 100%;
            padding: 11px 15px;
            background: var(--s2);
            border: 1px solid var(--bd);
            border-radius: var(--r);
            font-size: 15px;
            color: var(--t1);
            font-family: inherit;
            transition: var(--tr)
        }

            .form-input:focus {
                outline: none;
                border-color: rgba(91,156,246,.5);
                background: var(--s3);
                box-shadow: 0 0 0 3px var(--blue-g)
            }

            .form-input::placeholder { color: var(--t3) }

        select.form-input { cursor: pointer }

            select.form-input option { background: var(--s2) }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px
        }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.75);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 500;
            align-items: center;
            justify-content: center;
            padding: 24px
        }

            .modal.open { display: flex }

        .modal-box {
            background: var(--s1);
            border: 1px solid var(--bd2);
            border-radius: var(--rxl);
            width: 100%;
            max-width: 520px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 24px 80px rgba(0,0,0,.45),0 8px 24px rgba(0,0,0,.3);
            animation: modalIn .2s ease
        }

            .modal-box.wide { max-width: 700px }

        .modal-head {
            padding: 22px 26px 0;
            display: flex;
            justify-content: space-between;
            align-items: center
        }

            .modal-head h3 {
                font-size: 17px;
                font-weight: 700
            }

        .modal-body { padding: 20px 26px 26px }

        .modal-foot {
            padding: 0 26px 22px;
            display: flex;
            justify-content: flex-end;
            gap: 10px
        }

        .modal-close {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            background: var(--s3);
            border: none;
            color: var(--t2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            transition: var(--tr)
        }

            .modal-close:hover { color: var(--t1); background: var(--s4) }

        /* ALERTS */
        .alert {
            padding: 13px 17px;
            border-radius: var(--r);
            font-size: 14px;
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin-bottom: 16px;
            border: 1px solid;
            line-height: 1.55
        }

        .alert-error {
            background: var(--red-g);
            border-color: rgba(248,113,113,.25);
            color: var(--red)
        }

        .alert-success {
            background: var(--green-g);
            border-color: rgba(64,217,158,.25);
            color: var(--green)
        }

        .alert-info {
            background: var(--blue-g2);
            border-color: rgba(91,156,246,.2);
            color: var(--blue)
        }

        /* SPINNER */
        .spin {
            display: inline-block;
            width: 15px;
            height: 15px;
            border: 2px solid var(--bd2);
            border-radius: 50%;
            border-top-color: currentColor;
            animation: spinning .7s linear infinite
        }

        @@keyframes spinning { to { transform: rotate(360deg) } }

        @@keyframes modalIn {
            from { opacity: 0; transform: translateY(10px) scale(.97) }
            to   { opacity: 1; transform: none }
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px) }
            to   { opacity: 1; transform: none }
        }

        .fade-up { animation: fadeUp .35s ease forwards }

        /* DIVIDER */
        .divider { height: 1px; background: var(--bd); margin: 22px 0 }

        /* TABLE */
        .tbl-wrap {
            overflow-x: auto;
            border-radius: var(--rl);
            border: 1px solid var(--bd)
        }

        table { width: 100%; border-collapse: collapse; font-size: 14px }

        thead th {
            padding: 12px 16px;
            text-align: left;
            font-size: 12px;
            font-weight: 600;
            color: var(--t3);
            text-transform: uppercase;
            letter-spacing: .5px;
            background: var(--s2);
            border-bottom: 1px solid var(--bd);
            white-space: nowrap
        }

        tbody td {
            padding: 13px 16px;
            border-bottom: 1px solid var(--bd);
            vertical-align: middle
        }

        tbody tr:last-child td { border-bottom: none }

        tbody tr:hover { background: var(--s2) }

        .mono {
            font-family: 'JetBrains Mono',monospace;
            font-size: 13px;
            color: var(--blue)
        }

        /* FOOTER */
        footer {
            background: var(--s1);
            border-top: 1px solid var(--bd);
            padding: 18px 0;
            margin-top: auto
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 13px;
            color: var(--t3)
        }

        @@media(max-width:768px) {
            .nav-center { display: none }
            .form-row { grid-template-columns: 1fr }
            .wrap, .wrap-xl { padding: 0 18px }
            main { padding: 28px 0 64px }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (Session["EmployeeID"] != null)
    {
        <nav>
            <div class="nav-inner">
                <a href="@Url.Action("Index","Home")" class="nav-brand">
                    <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
                    <div class="brand-text">
                        <div class="brand-name">ABC Portal</div>
                        <div class="brand-sub">IOI Oleochemical</div>
                    </div>
                </a>
                <div class="nav-center">
                    <a href="@Url.Action("Index","Home")" class="nav-link @(ViewBag.ActivePage == "home" ? "active" : "")">
                        <i class="fas fa-house"></i> Dashboard
                    </a>
                    @if (Session["SuperUser"]?.ToString() == "1")
                    {
                        <a href="@Url.Action("Dashboard","Admin")" class="nav-link @(ViewBag.ActivePage == "admin" ? "active" : "")">
                            <i class="fas fa-gauge"></i> Admin
                        </a>
                    }
                </div>
                <div class="nav-right">
                    <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle light/dark mode">
                        <i class="fas fa-sun" id="themeIcon"></i>
                    </button>
                    <a href="@Url.Action("Index","Profile")" class="user-chip" style="text-decoration:none">
                        <div class="user-av" id="navAvatar"></div>
                        <div class="user-info">
                            <div class="user-name">@Session["UserName"]</div>
                            <div class="user-id">@Session["EmployeeID"]</div>
                        </div>
                    </a>
                    <a href="@Url.Action("Logout","Auth")" class="btn-nav">
                        <i class="fas fa-arrow-right-from-bracket"></i> Logout
                    </a>
                </div>
            </div>
        </nav>
        <script>
(function(){var n='@Session["UserName"]';var i=n.split(' ').map(function(x){return x[0]||'';}).join('').toUpperCase().substring(0,2);document.getElementById('navAvatar').textContent=i;})();
        </script>
    }
    @if (Session["EmployeeID"] == null)
    {
        <button class="theme-toggle" id="themeToggleGuest" onclick="toggleTheme()" title="Toggle light/dark mode"
                style="position:fixed;top:16px;right:16px;z-index:999">
            <i class="fas fa-sun" id="themeIconGuest"></i>
        </button>
    }
    <main>@RenderBody()</main>
    <footer>
        <div class="wrap">
            <div class="footer-inner">
                <span><i class="fas fa-shield-halved" style="color:var(--blue);margin-right:6px"></i>ABC Compliance Training Portal</span>
                <span>IOI Oleochemical &copy; @DateTime.Now.Year — Proprietary &amp; Confidential</span>
            </div>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
    <script>
        // ── THEME TOGGLE ───────────────────────────────────────────────
        (function () {
            // Load saved theme from cookie (persists across sessions)
            function getCookie(name) {
                var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
                return m ? decodeURIComponent(m[1]) : null;
            }
            function setCookie(name, val, days) {
                var d = new Date(); d.setTime(d.getTime() + days * 86400000);
                document.cookie = name + '=' + encodeURIComponent(val) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
            }

            var saved = getCookie('abc_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
            updateIcons(saved);

            window.toggleTheme = function () {
                var current = document.documentElement.getAttribute('data-theme') || 'dark';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                setCookie('abc_theme', next, 365);
                updateIcons(next);
            };

            function updateIcons(theme) {
                var icons = document.querySelectorAll('#themeIcon,#themeIconGuest');
                icons.forEach(function (el) {
                    if (theme === 'light') {
                        el.className = 'fas fa-moon';
                        el.parentNode.title = 'Switch to dark mode';
                    } else {
                        el.className = 'fas fa-sun';
                        el.parentNode.title = 'Switch to light mode';
                    }
                });
            }
        }());
    </script>
    <script>
// ── SESSION KEEPALIVE ──────────────────────────────────────────
// Pings the server every 4 minutes to prevent session expiry
// while user is in the training tab. Silent — no UI impact.
(function () {
    var PING_INTERVAL = 4 * 60 * 1000; // 4 minutes in ms
    var pingUrl = '@Url.Action("Ping", "Auth")';

    function ping() {
        fetch(pingUrl, { method: 'GET', credentials: 'same-origin' })
            .catch(function () { /* silent fail — session may have expired */ });
    }

    // Start pinging as long as the page is open
    setInterval(ping, PING_INTERVAL);

    // Also ping immediately when user comes back to this tab
    // (e.g. after finishing training in the other tab)
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') ping();
    });
}());
    </script>
</body>
</html>
