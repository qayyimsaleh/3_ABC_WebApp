@model ABC_WebApp.Models.Employee
@{
    ViewBag.Title = "My Profile";
    ViewBag.ActivePage = "profile";
}
@section Styles {
    <style>
        .profile-wrap {
            max-width: 560px;
            margin: 48px auto;
            padding: 0 20px
        }

        .page-head {
            margin-bottom: 32px
        }

            .page-head h1 {
                font-size: 24px;
                font-weight: 700;
                letter-spacing: -.3px;
                margin-bottom: 4px
            }

            .page-head p {
                font-size: 14px;
                color: var(--t3)
            }

        .info-card {
            background: var(--s1);
            border: 1px solid var(--bd);
            border-radius: var(--rxl);
            padding: 24px 28px;
            margin-bottom: 24px;
            box-shadow: 0 1px 3px rgba(0,0,0,.3)
        }

        [data-theme="light"] .info-card {
            box-shadow: 0 1px 3px rgba(0,0,0,.06),0 4px 16px rgba(0,0,0,.04)
        }

        .info-card-head {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--t3);
            margin-bottom: 20px
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--bd)
        }

            .info-row:last-child { border-bottom: none }

        .info-label {
            font-size: 13px;
            color: var(--t3)
        }

        .info-value {
            font-size: 14px;
            font-weight: 500
        }

        .section-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--t3);
            margin-bottom: 16px
        }

        .input-wrap { position: relative }

            .input-wrap .input-icon {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--t3);
                font-size: 14px;
                pointer-events: none
            }

            .input-wrap .form-input { padding-left: 40px }

        .pw-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--t3);
            cursor: pointer;
            font-size: 14px;
            padding: 4px
        }

            .pw-toggle:hover { color: var(--t1) }
    </style>
}
<div class="profile-wrap fade-up">
    <div class="page-head">
        <h1><i class="fas fa-circle-user" style="color:var(--blue);margin-right:10px"></i>My Profile</h1>
        <p>View your account details and manage your password.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom:20px">
            <i class="fas fa-circle-check"></i><span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error" style="margin-bottom:20px">
            <i class="fas fa-circle-exclamation"></i><span>@TempData["Error"]</span>
        </div>
    }

    <div class="info-card">
        <div class="info-card-head">Account Information</div>
        <div class="info-row">
            <span class="info-label">Employee ID</span>
            <span class="info-value">@Model.EmployeeID</span>
        </div>
        <div class="info-row">
            <span class="info-label">Full Name</span>
            <span class="info-value">@Model.UserName</span>
        </div>
        <div class="info-row">
            <span class="info-label">Department</span>
            <span class="info-value">@Model.Department</span>
        </div>
        <div class="info-row">
            <span class="info-label">Company</span>
            <span class="info-value">@Model.CompanyID</span>
        </div>
        <div class="info-row">
            <span class="info-label">Role</span>
            <span class="info-value">@(Model.SuperUser == "1" ? "Administrator" : "Employee")</span>
        </div>
    </div>

    <div class="section-title">Change Password</div>
    <div class="info-card">
        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Current Password</label>
                <div class="input-wrap">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" name="currentPassword" id="pwCurrent" class="form-input" placeholder="Enter current password" autocomplete="current-password" />
                    <button type="button" class="pw-toggle" onclick="togglePw('pwCurrent',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">New Password</label>
                <div class="input-wrap">
                    <i class="fas fa-lock-open input-icon"></i>
                    <input type="password" name="newPassword" id="pwNew" class="form-input" placeholder="Minimum 6 characters" autocomplete="new-password" />
                    <button type="button" class="pw-toggle" onclick="togglePw('pwNew',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <div class="input-wrap">
                    <i class="fas fa-lock-open input-icon"></i>
                    <input type="password" name="confirmPassword" id="pwConfirm" class="form-input" placeholder="Re-enter new password" autocomplete="new-password" />
                    <button type="button" class="pw-toggle" onclick="togglePw('pwConfirm',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:4px">
                <i class="fas fa-key"></i> Update Password
            </button>
        }
    </div>
</div>
@section Scripts {
    <script>
function togglePw(id,btn){
    var inp=document.getElementById(id);
    var show=inp.type==='password';
    inp.type=show?'text':'password';
    btn.querySelector('i').className='fas fa-eye'+(show?'-slash':'');
}
    </script>
}
