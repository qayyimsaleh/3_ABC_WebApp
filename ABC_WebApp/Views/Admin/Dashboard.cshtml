function loadArchive(){
    document.getElementById('archiveBody').innerHTML='<tr><td colspan="8" style="text-align:center;padding:24px"><span class="spin" style="border-top-color:var(--blue)"></span></td></tr>';
    fetch('@Url.Action("GetArchivedEmployees","Admin")')
    .then(function(r){
        if(!r.ok){return r.text().then(function(t){throw new Error('HTTP '+r.status+': '+t.substring(0,200));});}
        return r.json();
    }).then(function(d){
        allArchived=d; filteredArchived=d;
        filterArchive();
        updateArchiveBadge();
    }).catch(function(e){
        document.getElementById('archiveBody').innerHTML='<tr><td colspan="8"><div class="empty" style="color:var(--red)"><i class="fas fa-triangle-exclamation"></i> Failed to load archive: '+e.message+'</div></td></tr>';
        console.error('loadArchive error:',e);
    });
}

function filterArchive(){
    var s=document.getElementById('archSearch').value.toLowerCase();
    filteredArchived=allArchived.filter(function(e){
        return !s||(e.EmployeeID.toLowerCase().includes(s)||e.UserName.toLowerCase().includes(s)||e.Department.toLowerCase().includes(s));
    });
    renderArchive();
}

function renderArchive(){
