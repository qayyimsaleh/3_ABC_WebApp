            '<td><div class="action-btns">'+
                '<button class="btn btn-ghost btn-sm" style="color:var(--green);border-color:rgba(52,211,153,.3)" onclick="openRestore(\''+esc(e.EmployeeID)+'\',\''+esc(e.UserName)+'\')" ><i class="fas fa-rotate-left"></i> Restore</button>'+
            '</div></td>'+
            '</tr>';
    }).join('');
