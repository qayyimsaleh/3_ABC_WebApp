// ── SCORE ARCHIVE ─────────────────────────────────────────────────────────────
var allArchivedScores=[], filteredArchivedScores=[], selectedScoreIDs=new Set();

function loadArchivedScores(){
    var yr=document.getElementById('saYear').value;
    document.getElementById('scoreArchiveBody').innerHTML='<tr><td colspan="12" style="text-align:center;padding:24px"><span class="spin" style="border-top-color:var(--purple)"></span></td></tr>';
    var url='@Url.Action("GetArchivedScores","Admin")?'+(yr?'year='+encodeURIComponent(yr):'');
    fetch(url)
    .then(function(r){if(!r.ok) throw new Error('HTTP '+r.status);return r.json();})
    .then(function(d){
        allArchivedScores=d; filteredArchivedScores=d;
        filterArchivedScores();
        updateScoreArchiveBadge();
        loadArchivedScoreYears();
    }).catch(function(e){
        document.getElementById('scoreArchiveBody').innerHTML='<tr><td colspan="12"><div class="empty" style="color:var(--red)"><i class="fas fa-triangle-exclamation"></i> '+e.message+'</div></td></tr>';
    });
}

function loadArchivedScoreYears(){
    fetch('@Url.Action("GetArchivedScoreYears","Admin")')
    .then(function(r){return r.json();}).then(function(years){
        var sel=document.getElementById('saYear');
        var cur=sel.value;
        while(sel.options.length>1) sel.remove(1);
        years.forEach(function(y){var o=document.createElement('option');o.value=y;o.textContent=y;sel.appendChild(o);});
        if(cur) sel.value=cur;
    });
}

function filterArchivedScores(){
    var s=document.getElementById('saSearch').value.toLowerCase();
    filteredArchivedScores=allArchivedScores.filter(function(e){
        return !s||(e.EmployeeID.toLowerCase().includes(s)||e.UserName.toLowerCase().includes(s)||(e.Department&&e.Department.toLowerCase().includes(s)));
    });
    renderArchivedScores();
}

function renderArchivedScores(){
    document.getElementById('scoreArchiveCount').textContent=filteredArchivedScores.length+' records';
    var tb=document.getElementById('scoreArchiveBody');
    if(!filteredArchivedScores.length){
        tb.innerHTML='<tr><td colspan="12"><div class="empty"><i class="fas fa-database"></i>No archived score records</div></td></tr>';
        return;
    }
    tb.innerHTML=filteredArchivedScores.map(function(e){
        var key=e.Part+'_'+e.ID;
        var sel=selectedScoreIDs.has(key);
        var partBadge=e.Part==='Part1'?'<span class="badge badge-blue">Part 1</span>':'<span class="badge badge-purple">Part 2</span>';
        var statusBadge=e.ScoreStatus==='pass'?'<span class="badge badge-pass"><i class="fas fa-check"></i> pass</span>':'<span class="badge badge-fail"><i class="fas fa-xmark"></i> '+esc(e.ScoreStatus)+'</span>';
        return '<tr class="'+(sel?'selected':'')+'" style="opacity:.85">'+
            '<td class="cb-cell"><input type="checkbox" class="row-sel" '+(sel?'checked':'')+' onchange="toggleScoreSel(\''+key+'\',this.checked)"></td>'+
            '<td>'+partBadge+'</td>'+
            '<td class="mono">'+esc(e.EmployeeID)+'</td>'+
            '<td style="font-weight:500">'+esc(e.UserName)+'</td>'+
            '<td style="color:var(--t2)">'+esc(e.Department||'\u2014')+'</td>'+
            '<td class="mono">'+e.TrainingYear+'</td>'+
            '<td class="mono">'+esc(e.ScorePercentage)+'%</td>'+
            '<td>'+statusBadge+'</td>'+
            '<td style="font-size:12px;color:var(--t3);font-family:\'JetBrains Mono\',monospace">'+(e.Timestamp?fmtDT(e.Timestamp):'\u2014')+'</td>'+
            '<td style="font-size:12px;color:var(--t3);font-family:\'JetBrains Mono\',monospace">'+(e.ArchivedAt?fmtDT(e.ArchivedAt):'\u2014')+'</td>'+
            '<td class="mono" style="font-size:12px;color:var(--t3)">'+esc(e.ArchivedBy||'\u2014')+'</td>'+
            '<td><button class="btn btn-ghost btn-sm" style="color:var(--green);border-color:rgba(52,211,153,.3)" onclick="restoreSingleScore(\''+e.Part+'\','+e.ID+')"><i class="fas fa-rotate-left"></i></button></td>'+
            '</tr>';
    }).join('');
}

function updateScoreArchiveBadge(){
    var badge=document.getElementById('scoreArchiveBadge');
    if(allArchivedScores.length>0){badge.textContent=allArchivedScores.length;badge.style.display='inline';}
    else{badge.style.display='none';}
}

// ── SCORE SELECTION ───────────────────────────────────────────────────────────
function toggleScoreSel(key, checked){
    if(checked) selectedScoreIDs.add(key); else selectedScoreIDs.delete(key);
    updateScoreBulkBar();
}

function toggleSelectAllScores(checked){
    filteredArchivedScores.forEach(function(e){
        var key=e.Part+'_'+e.ID;
        if(checked) selectedScoreIDs.add(key); else selectedScoreIDs.delete(key);
    });
    renderArchivedScores(); updateScoreBulkBar();
}

function clearScoreSelection(){
    selectedScoreIDs.clear();
    document.getElementById('selectAllScoreCb').checked=false;
    renderArchivedScores(); updateScoreBulkBar();
}

function updateScoreBulkBar(){
    var n=selectedScoreIDs.size;
    document.getElementById('scoreBulkBar').classList.toggle('show',n>0);
    document.getElementById('scoreBulkCount').textContent=n+' selected';
}

// ── RESTORE SCORES ────────────────────────────────────────────────────────────
function restoreSingleScore(part, id){
    var table=part==='Part1'?'partOne_scores':'partTwo_scores';
    fetch('@Url.Action("RestoreScoreRecords","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:'__RequestVerificationToken='+encodeURIComponent(tok())+'&table='+encodeURIComponent(table)+'&ids[0]='+id})
    .then(function(r){return r.json();}).then(function(d){
        if(d.success){toast(d.message,'success');loadArchivedScores();loadReport();}
        else toast('Error: '+d.message,'error');
    }).catch(function(){toast('Network error','error');});
}

function restoreSelectedScores(){
    if(!selectedScoreIDs.size){toast('No records selected','error');return;}
    if(!confirm('Restore '+selectedScoreIDs.size+' selected score records back to active reports?')) return;
    var p1ids=[], p2ids=[];
    selectedScoreIDs.forEach(function(key){
        var parts=key.split('_');
        if(parts[0]==='Part1') p1ids.push(parseInt(parts[1]));
        else p2ids.push(parseInt(parts[1]));
    });
    var promises=[];
    if(p1ids.length){
        var body='__RequestVerificationToken='+encodeURIComponent(tok())+'&table=partOne_scores';
        p1ids.forEach(function(id,i){body+='&ids['+i+']='+id;});
        promises.push(fetch('@Url.Action("RestoreScoreRecords","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body}).then(function(r){return r.json();}));
    }
    if(p2ids.length){
        var body='__RequestVerificationToken='+encodeURIComponent(tok())+'&table=partTwo_scores';
        p2ids.forEach(function(id,i){body+='&ids['+i+']='+id;});
        promises.push(fetch('@Url.Action("RestoreScoreRecords","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body}).then(function(r){return r.json();}));
    }
    Promise.all(promises).then(function(results){
        var total=results.reduce(function(s,r){return s+(r.count||0);},0);
        toast(total+' records restored','success');
        clearScoreSelection(); loadArchivedScores(); loadReport();
    }).catch(function(){toast('Network error','error');});
}

function restoreAllVisibleScores(){
    if(!filteredArchivedScores.length){toast('No records to restore','info');return;}
    if(!confirm('Restore all '+filteredArchivedScores.length+' visible archived score records?')) return;
    var p1ids=[], p2ids=[];
    filteredArchivedScores.forEach(function(e){
        if(e.Part==='Part1') p1ids.push(e.ID); else p2ids.push(e.ID);
    });
    var promises=[];
    if(p1ids.length){
        var body='__RequestVerificationToken='+encodeURIComponent(tok())+'&table=partOne_scores';
        p1ids.forEach(function(id,i){body+='&ids['+i+']='+id;});
        promises.push(fetch('@Url.Action("RestoreScoreRecords","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body}).then(function(r){return r.json();}));
    }
    if(p2ids.length){
        var body='__RequestVerificationToken='+encodeURIComponent(tok())+'&table=partTwo_scores';
        p2ids.forEach(function(id,i){body+='&ids['+i+']='+id;});
        promises.push(fetch('@Url.Action("RestoreScoreRecords","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body}).then(function(r){return r.json();}));
    }
    Promise.all(promises).then(function(results){
        var total=results.reduce(function(s,r){return s+(r.count||0);},0);
        toast(total+' records restored','success');
        loadArchivedScores(); loadReport();
    }).catch(function(){toast('Network error','error');});
}

// ── ARCHIVE SCORES MODAL ──────────────────────────────────────────────────────
function openArchiveScoresModal(){
    document.getElementById('archScoreMethod').value='year';
    onArchScoreMethodChange();
    // Populate year dropdown with active score years
    fetch('@Url.Action("GetActiveScoreYears","Admin")')
    .then(function(r){return r.json();}).then(function(years){
        var sel=document.getElementById('archScoreYear');
        sel.innerHTML='';
        years.forEach(function(y){var o=document.createElement('option');o.value=y;o.textContent=y;sel.appendChild(o);});
        if(!years.length) sel.innerHTML='<option value="">No active score data</option>';
        updateArchYearPreview();
    });
    updateArchSelectedPreview();
    document.getElementById('archiveScoresModal').classList.add('open');
}

function closeArchiveScoresModal(){document.getElementById('archiveScoresModal').classList.remove('open');}

function onArchScoreMethodChange(){
    var m=document.getElementById('archScoreMethod').value;
    document.getElementById('archScoreByYear').style.display=m==='year'?'block':'none';
    document.getElementById('archScoreByEmp').style.display=m==='employee'?'block':'none';
    document.getElementById('archScoreBySelected').style.display=m==='selected'?'block':'none';
}

function updateArchYearPreview(){
    var yr=document.getElementById('archScoreYear').value;
    if(!yr){document.getElementById('archYearPreview').innerHTML='';return;}
    var count=allScores.filter(function(e){return true;}).length;
    document.getElementById('archYearPreview').innerHTML='<i class="fas fa-circle-info" style="margin-right:4px;color:var(--amber)"></i>This will archive all Part 1 and Part 2 score records for training year <strong>'+yr+'</strong>.';
}

function previewArchEmp(){
    var id=document.getElementById('archScoreEmpID').value.trim();
    if(!id){document.getElementById('archEmpPreview').innerHTML='';return;}
    var emp=allEmps.find(function(e){return e.EmployeeID===id;});
    if(emp){
        document.getElementById('archEmpPreview').innerHTML='<i class="fas fa-user" style="margin-right:4px;color:var(--blue)"></i><strong>'+esc(emp.UserName)+'</strong> — '+esc(emp.Department||'No dept')+'. All their active score records will be archived.';
    } else {
        document.getElementById('archEmpPreview').innerHTML='<i class="fas fa-circle-question" style="margin-right:4px;color:var(--t3)"></i>Employee not found in current list (may still have score records).';
    }
}

function updateArchSelectedPreview(){
    var n=filteredScores.length;
    document.getElementById('archSelectedPreview').innerHTML=n>0?'<strong>'+n+'</strong> employees currently shown in the report. Their score records matching the current date range will be archived.':'No employees in current report view.';
}

function executeArchiveScores(){
    var m=document.getElementById('archScoreMethod').value;
    var btn=document.getElementById('archScoreBtn');
    btn.disabled=true; btn.innerHTML='<span class="spin"></span> Archiving...';

    if(m==='year'){
        var yr=document.getElementById('archScoreYear').value;
        if(!yr){toast('Select a year','error');btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        if(!confirm('Archive ALL score records for year '+yr+'? Records can be restored from the Score Archive tab.')) {btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        fetch('@Url.Action("ArchiveScoresByYear","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:'__RequestVerificationToken='+encodeURIComponent(tok())+'&year='+encodeURIComponent(yr)})
        .then(function(r){return r.json();}).then(function(d){
            btn.disabled=false; btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';
            if(d.success){closeArchiveScoresModal();toast(d.message,'success');loadReport();}
            else toast('Error: '+d.message,'error');
        }).catch(function(){btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';toast('Network error','error');});
    }
    else if(m==='employee'){
        var empID=document.getElementById('archScoreEmpID').value.trim();
        if(!empID){toast('Enter an Employee ID','error');btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        if(!confirm('Archive all score records for employee '+empID+'?')){btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        fetch('@Url.Action("ArchiveScoresByEmployee","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:'__RequestVerificationToken='+encodeURIComponent(tok())+'&empID='+encodeURIComponent(empID)})
        .then(function(r){return r.json();}).then(function(d){
            btn.disabled=false; btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';
            if(d.success){closeArchiveScoresModal();toast(d.message,'success');loadReport();}
            else toast('Error: '+d.message,'error');
        }).catch(function(){btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';toast('Network error','error');});
    }
    else if(m==='selected'){
        if(!filteredScores.length){toast('No employees in current report view','error');btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        if(!confirm('Archive score records for '+filteredScores.length+' employees currently shown in the report?')){btn.disabled=false;btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';return;}
        // Archive by each employee in the filtered list
        var ids=filteredScores.map(function(e){return e.EmployeeID;});
        var done=0, total=ids.length;
        function archNext(i){
            if(i>=ids.length){
                btn.disabled=false; btn.innerHTML='<i class="fas fa-box-archive"></i> Archive Scores';
                closeArchiveScoresModal();
                toast(done+' employees\' scores archived','success');
                loadReport();
                return;
            }
            fetch('@Url.Action("ArchiveScoresByEmployee","Admin")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
                body:'__RequestVerificationToken='+encodeURIComponent(tok())+'&empID='+encodeURIComponent(ids[i])})
            .then(function(r){return r.json();}).then(function(d){
                if(d.success) done++;
                archNext(i+1);
            }).catch(function(){archNext(i+1);});
        }
        archNext(0);
    }
}


loadAll();
    </script>
    @Html.AntiForgeryToken()
}
